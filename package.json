{
  "name": "dsh-run-code-itself",
  "version": "0.4.1",
  "description": "Expose the complete run_code tool-call arguments to DSH PTC programs as run_code_itself, with unescaped extra fields.",
  "type": "module",
  "license": "MIT",
  "author": "CCCAUCHY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CCCAUCHY/dsh-run-code-itself.git"
  },
  "bugs": {
    "url": "https://github.com/CCCAUCHY/dsh-run-code-itself/issues"
  },
  "homepage": "https://github.com/CCCAUCHY/dsh-run-code-itself#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ptc",
    "run_code"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "icon.svg"
  ],
  "engines": {
    "dsh": "^0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-ptc": "^0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "check": "node --check index.js",
    "test": "node --experimental-loader ./test/loader.mjs ./test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
